# Required
DISCORD_TOKEN=

# SQLite database. Keep this path on a persistent Docker volume.
DATABASE_PATH=data/giveaway.db

# Optional global fallback images (must be public http/https URLs)
GIVEAWAY_IMAGE_URL=
WINNER_IMAGE_URL=

# Optional default reward-ticket category ID
TICKET_CATEGORY_ID=

# Optional logging channel ID (reserved for future audit logging)
LOG_CHANNEL_ID=

# Reward claim becomes available after this many seconds when /giveaway create
# does not specify reward_delay. Example: 0, 1800, 3600
DEFAULT_REWARD_DELAY=0

# How long winners have to claim after the reward becomes ready.
# Default = 24 hours.
CLAIM_WINDOW_SECONDS=86400

# Optional: set your test server ID for near-instant slash-command registration.
# Leave empty for global registration.
SYNC_GUILD_ID=

# Optional emoji overrides
EMOJI_GIFT=🎁
EMOJI_ARROW=➜
EMOJI_USERS=👥
EMOJI_HOST=👤
EMOJI_SPONSOR=💎
EMOJI_WINNER=🏆
EMOJI_TICKET=🎟️
EMOJI_CLAIM=🎁
EMOJI_CHECK=✅
EMOJI_CROSS=❌
EMOJI_CLOCK=⏱️
